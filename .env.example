# MongoDB connection string
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tiger?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Production: set this to the exact deployed origin, e.g. https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Google OAuth for public player sign-in.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary media storage for admin image/video uploads.
# Create a free account at https://cloudinary.com and copy these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional emergency/admin credential fallback when no MongoDB admin is seeded.
# Use a long random value in .env.local and never commit that file.
ADMIN_PASSWORD=

# YouTube feed configuration. Keep the API key server-side; never use NEXT_PUBLIC_ here.
# RSS works with only the channel ID. The Data API key is optional but more reliable.
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# Used once by scripts/seed.ts to create the first admin user.
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=
